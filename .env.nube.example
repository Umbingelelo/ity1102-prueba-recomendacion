# .env de la EC2 (EP3). Cópialo:  cp .env.nube.example .env   y completa lo que está vacío.
# El .env NUNCA va a Git (está en .gitignore). Aquí viven los secretos; en el repositorio, nunca.

# Los tres archivos que forman el sistema en la nube (ver compose.nube.yaml)
COMPOSE_FILE=compose.yaml:compose.nube.yaml:compose.cloudwatch.yaml
COMPOSE_PROJECT_NAME=proyecto

# La versión de las imágenes. El pipeline la cambia por el sha de cada despliegue (TAG=sha-xxxxxxx)
TAG=ep3

# El gateway ya no se publica hacia afuera: solo Caddy (80/443). Queda solo para la propia EC2
PUERTO_GATEWAY=127.0.0.1:8080

# Tu IP elástica con guiones + .sslip.io   (ejemplo: 3-85-10-20.sslip.io)
DOMINIO=

# El modelo vive en SageMaker (EP3). El endpoint lo creó sagemaker/3_endpoint.py: ep3-<caso>
MOTOR=sagemaker
ENDPOINT=

# Claves que acepta la API en X-API-Key, separadas por coma. Inventa una larga:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=
LIMITE_POR_MINUTO=60

# Contraseña de PostgreSQL de este servidor (no la de ejemplo «app»)
POSTGRES_PASSWORD=

# La clave que creaste en build.nvidia.com y el modelo que publicó el docente en el foro
NVIDIA_API_KEY=
NVIDIA_MODEL=
